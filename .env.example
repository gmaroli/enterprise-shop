# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://shop:shop_local_pw@localhost:5432/shop?schema=public

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3001
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Stripe (TEST mode keys only; get them from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Analytics warehouse (separate database on the same Postgres server)
WAREHOUSE_URL=postgresql://shop:shop_local_pw@localhost:5432/warehouse

# Country detection from the visitor's IP (local database, no account, no network calls).
# On localhost your address is private and has no country, so GEO_DEV_IP stands in for it.
# Example: 1.1.1.1 resolves to Australia, 8.8.8.8 to the United States, 81.2.69.142 to the United Kingdom.
GEO_DEV_IP=
GEO_DEFAULT_COUNTRY=US
