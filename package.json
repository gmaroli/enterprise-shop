{
  "name": "enterprise-shop",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @shop/db migrate",
    "db:seed": "pnpm --filter @shop/db seed",
    "db:reset": "pnpm --filter @shop/db reset",
    "db:seed:demo": "pnpm --filter @shop/db seed:demo",
    "warehouse:init": "pnpm --filter @shop/etl warehouse:init",
    "warehouse:run": "pnpm --filter @shop/etl warehouse:run",
    "warehouse:full": "pnpm --filter @shop/etl warehouse:full",
    "warehouse:status": "pnpm --filter @shop/etl warehouse:status",
    "stripe:listen": "mkdir -p .stripe && dotenv -e .env -- sh -c 'STRIPE_API_KEY=$STRIPE_SECRET_KEY STRIPE_CLI_TELEMETRY_OPTOUT=1 stripe listen --config .stripe/config.toml --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired --forward-to localhost:4000/api/webhooks/stripe'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stripe/cli": "^1.55.8",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
