{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--isolated", "--headless", "--caps=devtools"],
      "env": {}
    },
    "playwright-mobile": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--isolated",
        "--headless",
        "--caps=devtools",
        "--device",
        "iPhone 15"
      ],
      "env": {}
    }
  }
}
